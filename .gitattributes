# Generated by tools/make_patch.py against upstream's CRLF sources: the context lines carry
# the source file's own line endings, so any EOL normalization silently breaks `git apply`.
*.patch             -text

# Scripts and sources must stay LF everywhere; a CRLF .sh fails under bash on macOS/Linux.
*.sh                text eol=lf
*.yml               text eol=lf
*.py                text eol=lf
*.strings           text eol=lf
*.json              text eol=lf
*.md                text eol=lf
